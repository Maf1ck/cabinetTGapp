# ---------- Фронтенд (потрапляє в браузер, секретів тут бути не може) ----------
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_BOT_USERNAME=nastya_nutri_bot

# ---------- Сервер (лише Vercel Environment Variables, НІКОЛИ не VITE_*) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Довільний випадковий рядок: Telegram надсилає його в заголовку вебхука
TELEGRAM_WEBHOOK_SECRET=...
# Telegram ID Анастасії (число). Дізнатися: написати боту @userinfobot
OWNER_TG_ID=0
# Секрет для крон-задач Vercel
CRON_SECRET=...

# Адреса кабінету для кнопки в боті (на Vercel береться сама з домену проєкту)
# APP_URL=https://cabinet.example.com
