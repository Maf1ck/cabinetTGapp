# ---------- Фронтенд (потрапляє в браузер, секретів тут бути не може) ----------
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_BOT_USERNAME=nastya_nutri_bot

# ---------- Сервер (лише Vercel Environment Variables, НІКОЛИ не VITE_*) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Project Settings → API → JWT Secret. Нею підписуємо JWT після входу через Telegram.
SUPABASE_JWT_SECRET=...
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Довільний випадковий рядок: Telegram надсилає його в заголовку вебхука
TELEGRAM_WEBHOOK_SECRET=...
# Telegram ID Насті (число). Дізнатися: написати боту @userinfobot
OWNER_TG_ID=0
# Секрет для крон-задач Vercel
CRON_SECRET=...
